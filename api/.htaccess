# Todas las peticiones a /api pasan por index.php (el router decide qué responder).
# Así ninguna carpeta interna (config, core, services...) se puede abrir desde el navegador,
# y una ruta como /api/config no choca con la carpeta api/config/.
RewriteEngine On
DirectorySlash Off
Options -Indexes

RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [QSA,L]
