# Variables de entorno (contraseñas, claves JWT)
.env
.env.*
!.env.example

# Dependencias de Composer: vendor/ SÍ se sube para que el proyecto
# funcione sin instalar Composer (solo trae firebase/php-jwt)

# Dependencias de Node (por si usas Tailwind CLI)
node_modules/

# Imágenes subidas desde el admin
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# Logs y temporales
*.log
logs/
tmp/
cache/

# Archivos del sistema
.DS_Store
Thumbs.db
desktop.ini

# Configuración del editor
.vscode/
.idea/

# Backups y comprimidos
*.zip
*.rar
*.bak