# ==========================================
# PIXELA CMS - Variables de entorno
# Copia este archivo como .env y pon tus valores
# ==========================================

# Entorno: development | production
APP_ENV=development

# Ruta base de la API (en XAMPP: /pixela-cms/api)
API_BASE=/pixela-cms/api

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pixela_cms
DB_USER=root
DB_PASS=

# JWT (usa una cadena larga y aleatoria, mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta_123456
JWT_EXPIRA_HORAS=8
